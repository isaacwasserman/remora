{
    "initialStepId": "start",
    "steps": [
        {
            "id": "start",
            "name": "Start",
            "description": "Entry point",
            "type": "start",
            "nextStepId": "get_front_page"
        },
        {
            "id": "get_front_page",
            "name": "Get Front Page",
            "description": "Fetch the Hacker News front page listings",
            "type": "tool-call",
            "params": {
                "toolName": "listHackernewsFrontPage",
                "toolInput": {}
            },
            "nextStepId": "loop_posts"
        },
        {
            "id": "loop_posts",
            "name": "Process Top 5 Posts",
            "description": "Iterate over the top 5 posts from the front page",
            "type": "for-each",
            "params": {
                "target": {
                    "type": "jmespath",
                    "expression": "get_front_page[:5]"
                },
                "itemName": "post",
                "loopBodyStepId": "get_post"
            },
            "nextStepId": "end"
        },

        {
            "id": "get_post",
            "name": "Get Post Details",
            "description": "Fetch the full post details from Hacker News",
            "type": "tool-call",
            "params": {
                "toolName": "getHackernewsPost",
                "toolInput": {
                    "id": {
                        "type": "jmespath",
                        "expression": "post.id"
                    }
                }
            },
            "nextStepId": "rate_limit"
        },
        {
            "id": "rate_limit",
            "name": "Rate Limit",
            "description": "Brief pause between API calls",
            "type": "sleep",
            "params": {
                "durationMs": {
                    "type": "literal",
                    "value": 1000
                }
            },
            "nextStepId": "route_engagement"
        },
        {
            "id": "route_engagement",
            "name": "Route by Engagement",
            "description": "High-engagement posts get comment analysis, others skip to sign-off",
            "type": "switch-case",
            "params": {
                "switchOn": {
                    "type": "jmespath",
                    "expression": "get_post.descendants > `20`"
                },
                "cases": [
                    {
                        "value": { "type": "literal", "value": true },
                        "branchBodyStepId": "get_comments"
                    },
                    {
                        "value": { "type": "default" },
                        "branchBodyStepId": "no_comments_end"
                    }
                ]
            },
            "nextStepId": "sign_off"
        },

        {
            "id": "get_comments",
            "name": "Get Comments",
            "description": "Fetch top comments for high-engagement posts",
            "type": "tool-call",
            "params": {
                "toolName": "getHackernewsComments",
                "toolInput": {
                    "postId": {
                        "type": "jmespath",
                        "expression": "post.id"
                    },
                    "limit": {
                        "type": "literal",
                        "value": 3
                    }
                }
            },
            "nextStepId": "comments_end"
        },
        {
            "id": "comments_end",
            "name": "Comments End",
            "description": "Output the fetched comments",
            "type": "end",
            "params": {
                "output": {
                    "type": "jmespath",
                    "expression": "get_comments"
                }
            }
        },
        {
            "id": "no_comments_end",
            "name": "No Comments End",
            "description": "No comments to fetch",
            "type": "end"
        },

        {
            "id": "sign_off",
            "name": "User Sign-Off",
            "description": "Present the post summary to the user for approval",
            "type": "request-intervention",
            "params": {
                "type": "multiple-choice",
                "question": {
                    "type": "template",
                    "template": "[${post.title}]\nBy: ${get_post.by} | Score: ${get_post.score} | Comments: ${get_post.descendants}\nURL: ${get_post.url}\n\nInclude in digest?"
                },
                "choices": {
                    "type": "literal",
                    "value": ["Include", "Skip"]
                },
                "allowFreeResponse": false
            },
            "nextStepId": "loop_end"
        },
        {
            "id": "loop_end",
            "name": "Loop Iteration End",
            "description": "Collect the post with its sign-off decision",
            "type": "end",
            "params": {
                "output": {
                    "type": "jmespath",
                    "expression": "{title: post.title, score: get_post.score, comments: get_post.descendants, url: post.url, decision: sign_off}"
                }
            }
        },

        {
            "id": "end",
            "name": "End",
            "description": "Output only the included posts",
            "type": "end",
            "params": {
                "output": {
                    "type": "jmespath",
                    "expression": "loop_posts[?decision == 'Include']"
                }
            }
        }
    ]
}
